dependencies

# pi agent state: per-machine by default, but the HARNESS CODE is shared.
# settings.json, npm/, messenger/ and APPEND_SYSTEM.md stay machine-local; extensions,
# skills and mcp.json are the repo's RE-harness implementation and belong in git so both
# hosts run identical tooling.
.pi/*
!.pi/extensions/
!.pi/skills/
!.pi/mcp.json
!.pi/settings.json

# GLLA runtime state: pid/instance owner locks, live goal jsonl, update scratch.
# Machine-local by design - committing it makes another host inherit (and fight)
# this machine's ownership claims. Durable findings belong in docs/f3, discoveries/,
# and artifacts/ledgers instead.
.pi-glla/

# Engram memory: .engram/config.json (project identity) is tracked; the exported
# chunks are memory payloads that would be permanent once committed.
.engram/chunks/
.engram/manifest.json

# Engram LIVE store (2026-10-23): migrated copy of ~/.engram, openvb-only canonical
# store for in-shell sessions (ENGRAM_DATA_DIR in devenv/environment/openvb.nix).
# Deliberately gitignored IN FULL - it is a live SQLite+WAL/SHM database; committing
# it would put an unmergeable, constantly-changing binary in git history.
.engram-data/

# host-built driver/probe binaries (tools/*.sh generate these; not artifacts)
tools/*.exe
tools/__pycache__/
/sdk-*.obj
*.obj
.$$$

