{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "github-read-only": {
      // https://github.com/github/github-mcp-server
      "enabled": true,
    },
    "github-read-write": {
      // https://github.com/github/github-mcp-server
      "enabled": false,
    },
    "math-mcp": {
      // https://github.com/EthanHenrickson/math-mcp
      "enabled": true,
    },
    "ida-pro": {
      // https://github.com/mrexodia/ida-pro-mcp
      "enabled": true
    },
    "local-rag": {
      // https://github.com/shinpr/mcp-local-rag
      "enabled": true
    }
  },
}
